{
  // Worker + static assets. The Worker (src/index.js) handles /api/* (beehiiv + Airtable),
  // everything else is served from ./public via the ASSETS binding.
  // Deploy:  cfrun wrangler deploy            -> https://asnm.alec-af3.workers.dev (production)
  //          cfrun wrangler deploy --env staging -> https://asnm-staging.alec-af3.workers.dev
  "name": "asnm",
  "compatibility_date": "2026-06-26",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "adaptivesportsnearme.com", "custom_domain": true },
    { "pattern": "www.adaptivesportsnearme.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "AIRTABLE_BASE_ID": "apphZsPGanzJ5xyl7",
    "AIRTABLE_INBOX_TABLE_ID": "tblBcgV7oQ9Q3q34L"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "asnm-staging",
      "main": "src/index.js",
      "workers_dev": true,
      "preview_urls": true,
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash"
      },
      "vars": {
        "AIRTABLE_BASE_ID": "apphZsPGanzJ5xyl7",
        "AIRTABLE_INBOX_TABLE_ID": "tblBcgV7oQ9Q3q34L"
      }
    }
  }
}
