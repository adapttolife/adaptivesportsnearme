{
	"name": "adaptivesportsnearme",
	"main": "src/staging.js",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": ["/*"]
	},
	"vars": {
		"ENV_NAME": "staging",
		"PRELAUNCH": "false",
		"MAIL_TRANSPORT": "resend",
		"MAIL_FROM": "Adaptive Sports Near Me <hello@mail.adaptivesportsnearme.com>",
		"MAIL_FROM_DOMAINS": "mail.adaptivesportsnearme.com",
		"RESEND_TOPIC_ID": "REPLACE_WITH_ASNM_NEWS_TOPIC_ID",
		"MAIL_ALLOW": "hello@adapttolife.org,@adaptivesportsnearme.com,@adapttolife.org,@faisaln.com",
		"GMAIL_FROM": "hello@adaptivesportsnearme.com",
		"REQUIRE_FORM_LIMITER": "true",
		"RESEND_SEGMENT_ID": "abae0ac1-1ed2-4d3b-9fb7-41f272a92f4a"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "asnm-db-staging",
			"database_id": "d3f67da7-60a3-44b6-9215-28665492d3f9",
			"remote": true
		},
		{
			"binding": "INTAKE",
			"database_name": "asnm-db-staging",
			"database_id": "d3f67da7-60a3-44b6-9215-28665492d3f9",
			"remote": true
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"triggers": {
		"crons": []
	},
	"observability": {
    "issues": { "enabled": true },
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "FORM_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 6,
				"period": 60
			}
		}
	],
	"account_id": "1d08b2fb0d19775b304a616ab3d4a48f",
	"compatibility_date": "2026-06-26"
}
